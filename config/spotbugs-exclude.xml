<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs (with Find Security Bugs) exclusions.

  Rule: every exclusion is as narrow as possible (class, method or bug pattern) and carries a
  comment explaining why the finding is a false positive or accepted. An exclusion without a
  justification is not accepted in review (CONTRIBUTING.md).
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.10.5/spotbugs/etc/findbugsfilter.xsd">

  <!--
    PHASE 3 ONLY (skeleton artifacts). Remove each entry in the phase that writes the bodies (core:
    Phase 4; logback: Phase 5):
    if SpotBugs still reports them against real code, they are real findings.
  -->

  <!--
    EQ_UNUSUAL: the skeleton's equals(Object) only throws UnsupportedOperationException("Not
    implemented yet"), which SpotBugs classifies as an "unusual" equals. Limited to equals in the
    five value types and MaskingPolicy.
  -->
  <Match>
    <Bug pattern="EQ_UNUSUAL"/>
    <Method name="equals" params="java.lang.Object" returns="boolean"/>
    <Or>
      <Class name="io.github.jhonwesleyy.securedatamasker.core.Cpf"/>
      <Class name="io.github.jhonwesleyy.securedatamasker.core.Cnpj"/>
      <Class name="io.github.jhonwesleyy.securedatamasker.core.Email"/>
      <Class name="io.github.jhonwesleyy.securedatamasker.core.PhoneNumber"/>
      <Class name="io.github.jhonwesleyy.securedatamasker.core.PixKey"/>
      <Class name="io.github.jhonwesleyy.securedatamasker.core.masking.MaskingPolicy"/>
    </Or>
  </Match>

  <!--
    UWF_UNWRITTEN_FIELD: the compact constructor of the Match record only throws, so javac never
    emits the field assignments and SpotBugs sees start, end and type as never written. Limited to
    that record.
  -->
  <Match>
    <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    <Class name="io.github.jhonwesleyy.securedatamasker.core.internal.Match"/>
  </Match>

  <!--
    CT_CONSTRUCTOR_THROW: the skeleton constructors of the two Logback classes (not final, because
    Logback instantiates and configures them) only throw UnsupportedOperationException. The real
    constructors written in Phase 5 do not throw. Limited to those constructors.
  -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    <Method name="&lt;init&gt;"/>
    <Or>
      <Class name="io.github.jhonwesleyy.securedatamasker.logback.MaskingConverter"/>
      <Class name="io.github.jhonwesleyy.securedatamasker.logback.MaskingPatternLayoutEncoder"/>
    </Or>
  </Match>
</FindBugsFilter>
